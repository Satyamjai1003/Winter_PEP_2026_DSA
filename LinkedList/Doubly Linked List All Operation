#include<iostream>
#include<bits/stdc++.h>
using namespace std;
class Node
{
    public:
    int data;
    Node* next;
    Node* prev;
    Node(int data)
    {
        this->data=data;
        next=NULL;
        prev=NULL;
    }
};
Node* InsertionAtStart(Node* head,int val)
{
    Node* newNode= new Node(val);
    newNode->next=head;
    head->prev=newNode;
    head=newNode;
    return head;
}

Node* InsertionAtEnd(Node* tail,int val)
{
    Node* newNode=new Node(val);
    tail->next=newNode;
    newNode->prev=tail;
    tail=newNode;
    return tail;

}

Node* DeletionAtStart(Node* head)
{
    head=head->next;
    head->prev=NULL;
    return head;
}

Node* DeletionAtEnd(Node* tail)
{
    tail=tail->prev;
    tail->next=NULL;
    return tail;
}

int main()
{
    Node* head = new Node(1);
    Node* tail=head;
    
    // Insertion at start
    head=InsertionAtStart(head,2);
    head=InsertionAtStart(head,3);
    head=InsertionAtStart(head,4);

    // Insertion At End
    tail=InsertionAtEnd(tail,2);
    tail=InsertionAtEnd(tail,3);
    tail=InsertionAtEnd(tail,4);

    // Deletion At Start
    head=DeletionAtStart(head);

    // Deletion At End
    tail=DeletionAtEnd(tail);

    Node* curr=head;
    while(curr!=NULL)
    {
        cout<<curr->data<<" ";
        curr=curr->next;
    }
    return 0;

}
