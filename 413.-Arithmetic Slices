class Solution {
public:
    int numberOfArithmeticSlices(vector<int>& nums) {
        int count =0;
        int total=0;
        int i;
        for(i=1;i<nums.size()-1;i++)
        {
            if(nums[i]-nums[i-1]==nums[i+1]-nums[i])
            {
                count++;
                total=total+count;
            }
            else
            {
                count=0;
            }
        }
        return total;
    }
};
