class Solution {
public:
    bool checkIfPangram(string sentence) {
        vector<int>freq(26);
        for(int x:sentence)
        {
            freq[x-'a']++;
        }
        for(auto y:freq)
        {
            if(y==0)
            {
                return false;
            }
        }
        return true;
    }
};

