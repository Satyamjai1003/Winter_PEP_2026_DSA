class Solution {
public:
    int numberOfArithmeticSlices(vector<int>& nums) {
        int n=nums.size();
        if(n<3) return 0;
        int total=0;
        int diff=nums[1]-nums[0];
        int currEle=2;
        int pos=1;
        int i;
        for(i=2;i<n;i++)
        {
            if(nums[i]-nums[i-1]==diff)
            {
                total+=pos++;
            }
            else
            {
                diff=nums[i]-nums[i-1];
                currEle=2;
                pos=1;
            }
        }
        return total;
    }
};
